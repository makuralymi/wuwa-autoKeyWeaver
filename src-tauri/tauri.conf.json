{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wuwa-music",
  "version": "0.1.0",
  "identifier": "com.wuwa.music-editor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "曲谱编辑器",
        "width": 1180,
        "height": 800,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "additionalBrowserArgs": "--disable-gpu-compositing"
      },
      {
        "label": "overlay",
        "title": "悬浮控制",
        "url": "overlay.html",
        "width": 300,
        "height": 196,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
